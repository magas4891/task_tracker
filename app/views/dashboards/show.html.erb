<div class="page-header">
  <h1>Dashboard</h1>
</div>

<div id='categories' class='d-flex gap-3 x-overflow-scrolling'>
  <%= render 'categories/uncategorized_tasks' %>
  <div id='namedCategories' class='d-flex gap-3' data-controller='sortable' data-sortable-target='categories'>
    <% @categories.each do |category| %>
      <%= render 'categories/category', category: category %>
    <% end %>
  </div>
</div>
<div id="task-panel-wrapper" class="task-panel-wrapper" data-controller="resizable-panel" data-resizable-panel-min-width-value="280" data-resizable-panel-max-width-value="900">
  <div class="task-panel-resize-handle" data-action="mousedown->resizable-panel#startResize" title="Drag to resize"></div>
  <div id="task-content" data-controller="task"></div>
</div>
